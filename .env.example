# Ключи и настройки ИИ храним вне репозитория: скопируйте в .env (он в .gitignore)
# Вариант 1 (по умолчанию, без аккаунта): локальная модель через Ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama
# Вариант 2: любой OpenAI-совместимый провайдер с бесплатным тарифом (Groq, OpenRouter, Gemini и т.п.)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=...
